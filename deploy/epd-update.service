# Template — deploy/install.sh fills in @PROJECT_DIR@ (installed releases only).
# Install with that script; a copy made by hand will not start.
[Unit]
Description=e-Paper calendar over-the-air update (newest signed release)
After=network-online.target time-sync.target
Wants=network-online.target
# Runs BEFORE each refresh (gcal-epd.service Wants= it), so the panel is
# drawn by the newest release; after Wi-Fi and calendar setup, never
# alongside them. A failed check does not stop the refresh (Wants=, not
# Requires=). epd-power.service sets the clock from the RTC before it.
# The power manager stays on while it or the refresh runs, and while one
# waits in the queue, for up to 5 min after the last unit ended.
After=epd-wifi-setup.service epd-feed-setup.service
Before=gcal-epd.service

[Service]
Type=oneshot
# Root: it writes /opt/e-pages and the units. The system python3, not the
# release's venv: a broken venv must not stop the update that fixes it.
WorkingDirectory=/
Environment=PYTHONPATH=@PROJECT_DIR@/src PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m gcal_epd.releases update
# Run-time limit for the check, download, verification, build and test
# render, counted from this unit's own start (waiting in the queue does not
# count; the power manager bounds that). At the limit systemd sends SIGTERM
# to the whole control group (pip, the build): the updater switches back to
# the release it was running and counts a failure, then the refresh runs.
TimeoutStartSec=6min
# Time to switch back and reinstall the old units before SIGKILL.
TimeoutStopSec=90s
Nice=10
StandardOutput=journal
StandardError=journal
