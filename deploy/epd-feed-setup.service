[Unit]
Description=e-Paper calendar setup form (first run, no feeds yet)
After=network-online.target
Wants=network-online.target
# Only until calendars are set up; gcal-epd.service has the opposite condition.
ConditionPathExists=!/home/admin/google-calendar-api/ics_feeds.toml

[Service]
Type=oneshot
User=admin
WorkingDirectory=/home/admin/google-calendar-api
# With no feeds, main serves the setup form (10 min window), then renders.
ExecStart=/home/admin/google-calendar-api/.venv/bin/python -m gcal_epd.main --display
# Form window (600 s) plus the panel refresh, with margin. gcal-epd.service
# keeps its short timeout because it never waits on a person.
TimeoutStartSec=900
Restart=no
StandardOutput=journal
StandardError=journal
