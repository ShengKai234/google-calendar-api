# Template — deploy/install.sh fills in @PROJECT_DIR@, @USER@ and @FEEDS_FILE@.
# Install with that script; a copy made by hand will not start.
[Unit]
Description=e-Paper calendar setup form (first run, no feeds yet)
After=network-online.target
Wants=network-online.target
# Only until calendars are set up; gcal-epd.service has the opposite condition.
ConditionPathExists=!@FEEDS_FILE@

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT_DIR@
# With no feeds, main serves the setup form (10 min window), then renders.
ExecStart=@PROJECT_DIR@/.venv/bin/python -m gcal_epd.main --display
# Form window (600 s) plus the panel refresh, with margin. gcal-epd.service
# keeps its short timeout because it never waits on a person.
TimeoutStartSec=900
Restart=no
StandardOutput=journal
StandardError=journal
