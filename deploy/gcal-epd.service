# Template — deploy/install.sh fills in @PROJECT_DIR@, @USER@, @FEEDS_FILE@ and @PENDING_FILE@.
# Install with that script; a copy made by hand will not start.
[Unit]
Description=Google Calendar e-Paper Display
After=network-online.target
Wants=network-online.target
# Scheduled refresh only once calendars are set up and no links from the
# Wi-Fi form wait to be checked; otherwise epd-feed-setup.service runs.
ConditionPathExists=@FEEDS_FILE@
ConditionPathExists=!@PENDING_FILE@

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT_DIR@

ExecStart=@PROJECT_DIR@/.venv/bin/python -m gcal_epd.main --display --no-setup

# No shutdown here: on a PiSugar battery, epd-power.service powers off
# after the refresh, once it has set the next wake-up alarm.

# Kill if taking longer than 120 seconds
TimeoutStartSec=120

# Do not retry on failure (timer will run again at next scheduled time)
Restart=no

StandardOutput=journal
StandardError=journal
