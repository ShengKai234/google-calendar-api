[Unit]
Description=e-Paper Wi-Fi setup (hotspot when no network)
# Default dependencies off: multi-user.target would otherwise wait on this
# oneshot, and boot would never finish while the hotspot is waiting.
DefaultDependencies=no
After=basic.target NetworkManager.service
Wants=NetworkManager.service
Conflicts=shutdown.target
# Keep the calendar refresh off the panel until Wi-Fi setup is done.
Before=shutdown.target gcal-epd.service

[Service]
Type=oneshot
# Root: nmcli must change connections and the form listens on port 80.
User=root
WorkingDirectory=/home/admin/google-calendar-api
# Do not leave root-owned __pycache__ in the admin user's checkout.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/admin/google-calendar-api/.venv/bin/python -m gcal_epd.wifi_setup --display --start-unit gcal-epd.service
# Setup waits for a person; there is no sensible deadline.
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
